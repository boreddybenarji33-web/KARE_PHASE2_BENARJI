import java.util.*;

class Main {
    void ps() {
        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();
        int flag = 0;

        for (int i = 1; i * i <= n; i++) {
            if (i * i == n) {
                flag = 1;
                System.out.print("Perfect Square");
                break;
            }
        }

        if (flag == 0) {
            System.out.print("Not a Perfect Square");
        }
    }

    public static void main(String[] args) {
        Main obj = new Main();
        obj.ps();
    }
}
