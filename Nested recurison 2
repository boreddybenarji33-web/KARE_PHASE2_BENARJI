class Main {

    public static int s(int n) {
        if (n <= 1) {
            return 1;
        }

        if (n % 2 == 0) {
            return s(s(n / 2));
        } else {
            return s(s(3 * n + 1));
        }
    }

    public static void main(String[] args) {
        int n = 6;
        System.out.println("nested " + s(n));
    }
}
